# Copy this file to .env and replace the example values.
POSTGRES_PASSWORD=replace_with_a_local_password
API_IMAGE=ghcr.io/eliasdavid98/pset4-pogo-api
IMAGE_TAG=latest
KESTRA_HOST_PORT=8081

# JDBC URL format: jdbc:snowflake://<account_identifier>.snowflakecomputing.com
SNOWFLAKE_URL=jdbc:snowflake://your_account.snowflakecomputing.com
# Snowflake account identifier without the domain, required by dbt.
SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_USERNAME=your_snowflake_user
# Set locally; never commit your real password.
SNOWFLAKE_PASSWORD=
# Base64-encoded SNOWFLAKE_PASSWORD for Kestra Open Source's secret() function.
SECRET_SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=CHURN_DB
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_GOLD_SCHEMA=GOLD
SNOWFLAKE_OBT_TABLE=OBT_CUSTOMER_CHURN
# Optional Snowflake role:
SNOWFLAKE_ROLE=

# MLflow should point to the Compose service inside containers.
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_MODEL_URI=models:/pset3-churn-classifier@champion
MLFLOW_HOST_PORT=5001

# Batch/API behavior. Keep the PSet3 decision threshold until it is formally changed.
CHURN_DECISION_THRESHOLD=0.5
PREDICTION_MODE=model
# Use manual_review_all to suspend automated decisions and route every case
# to human review; dummy_fallback is only a technical prior, not a business rule.
SNOWFLAKE_MONITORING_SCHEMA=MONITORING
OBT_SNAPSHOT_ID=
OBT_SOURCE_GOLD_TABLES=FACT_CUSTOMER_CHURN,DIM_GEOGRAPHY,DIM_GENDER,DIM_AGE_BAND,DIM_PRODUCT_COUNT
